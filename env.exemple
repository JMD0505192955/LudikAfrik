# ============================================================
#  Variables d'environnement de Ludikafrik.
#  Copiez ce fichier en ".env" et remplacez les valeurs marquées.
#    cp env.exemple .env
#  Le fichier .env ne doit JAMAIS être partagé ni mis sur GitHub.
# ============================================================

# --- Base de données (laissez tel quel sauf besoin particulier) ---
PGUSER=ludik
PGPASSWORD=CHANGEZ_ce_mot_de_passe_base
PGDATABASE=ludikafrik

# --- Secrets (À GÉNÉRER, voir le guide) ---
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REMPLACEZ_par_32_octets_aleatoires
OTP_SEL=REMPLACEZ_par_32_octets_aleatoires

# --- SMS d'inscription ---
# Tant qu'aucune passerelle n'est branchée : laissez false + démo true.
OTP_SMS_CONFIGURE=false
OTP_MODE_DEMO=true

# --- Back office ---
# Clé temporaire pour créer le tout premier administrateur (à retirer après).
ADMIN_CLE_INIT=REMPLACEZ_par_une_cle_temporaire

# --- Facturation Moov Africa (Togo et autres) ---
# Fournis par Moov (voir section 8 du document de flux). Laissez vides tant que non reçus.
MOOV_CONFIGURE=false
MOOV_SHORTCODE=XXX
MOOV_USSD=*XXX#
MOOV_API_PAIEMENT=
MOOV_API_CLE=
MOOV_SECRET_RAPPEL=
